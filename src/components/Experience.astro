---
const roles = [
  ['Lead Data Scientist, Global Retail & DTC Assortment Intelligence', 'EssilorLuxottica', 'Feb 2021 – present', 'I lead the data science unit for Global Retail & DTC Assortment Intelligence, optimizing assortment strategies across 18,000+ retail stores. I own the architecture and full lifecycle of AI initiatives, from discovery and solution design to full-scale production deployment, mainly on Azure and Databricks: Genie agents on governed lakehouse data, forecasting engines, anomaly detection, clustering, optimization and recommendation systems that drive automated decision-making at scale. I define target architectures, mentor a high-performing team, set Data and MLOps best practices, lead internal AI enablement, and have delivered measurable business impact: license savings, multi-FTE efficiency gains and incremental revenue.'],
  ['Co-founder & AI Consultant', 'FlyLabs.ai · Freelance', '2019 – present', 'Co-founded FlyLabs.ai, an AI studio shipping production AI products (Stellar Reviews, GPT Chatbot), several with live public demos. As an independent consultant I help teams use AI well and deliver production-grade solutions end to end, from discovery and solution architecture to production rollout: AI agents, LLM chatbots, automations and internal tools for dozens of businesses across industries. I also run tailored AI training for technical and non-technical teams. Recognized as a Vetted Pro on Fiverr (5/5 across 100+ projects).'],
  ['Co-founder & Technology Lead', 'Porta Moneta APS, nonprofit volunteer role', '2022 – present', 'Co-founded a Milan neighborhood NPO and built its digital operating layer as a volunteer: public website, WeGrocery ordering platform, AI chatbot for member support, digital membership workflows and lightweight internal operations.'],
  ['Senior Data Scientist', 'Nielsen', 'Sep 2017 – Feb 2021', 'Led predictive models (time series, classification, clustering) on audience and panel data across 10+ countries, and built scalable data pipelines.'],
  ['Data Scientist, Consultant', 'Bip — Business Integration Partners', 'Apr 2016 – Sep 2017', 'Big Data & Advanced Analytics CoE: delivered ML & NLP models at Sky Italy to improve retention and upselling.'],
  ['Data Science Consultant', 'SAS / Value Lab', 'Jun 2015 – Apr 2016', 'SAS Masterclass in Big Data & Analytics; built ETL pipelines and BI dashboards.'],
  ['Data Mining Junior Officer, Marketing Department', 'Università Bocconi, Milan', 'Jan 2015 – Jun 2015', 'Supported the Marketing Department with data mining and analysis (SAP-CRM, STATA), generating insights and reporting on customer satisfaction to support strategic decision-making.'],
];
---
<section id="experience" class="py-12 scroll-mt-20 border-t border-line">
  <h2 class="font-serif text-3xl mb-6">Experience</h2>
  <div class="space-y-6">
    {roles.map(([title, org, dates, desc]) => (
      <div>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4">
          <h3 class="font-medium">{title} <span class="text-muted font-normal">· {org}</span></h3>
          <span class="text-muted text-sm font-mono shrink-0">{dates}</span>
        </div>
        <p class="text-muted text-sm mt-1 leading-relaxed max-w-2xl">{desc}</p>
      </div>
    ))}
  </div>
</section>
