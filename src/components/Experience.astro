---
const roles = [
  ['Data Science Manager - DTC Category & Merchandising', 'EssilorLuxottica', 'Feb 2021 – present', 'I founded the DTC AI Data Science team from the ground up (1 to 5 people) and manage its portfolio of 20+ Data & AI projects a year, from architecture to production, supporting the 200+ person business team managing assortment for 18,000+ stores across 100+ markets. I built the team\'s Databricks lakehouse (medallion architecture, Unity Catalog) and its engineering kit (AGENTS.md, branching and worktrees, PR-based CI/CD, Declarative Automation Bundles, automated tests). On top of it we run forecasting, anomaly detection, clustering, optimization and recommendation engines, 8 web apps serving 100+ business users, and Genie agents and LLM systems that give the DTC Category & Merchandising team natural-language access to enterprise data and advanced conversational analytics.'],
  ['Co-founder & Technology Lead', 'Porta Moneta APS, nonprofit volunteer role', '2022 – present', 'Co-founded a Milan neighborhood NPO and built its digital operating layer as a volunteer: public website, WeGrocery ordering platform, AI chatbot for member support, digital membership workflows and lightweight internal operations.'],
  ['AI Consultant & Trainer', 'Freelance', '2019 – present', 'I deliver AI agents, LLM chatbots, machine learning models and automation for 50+ clients across 100+ projects globally, from discovery and solution architecture to production rollout, and I ship my own AI products (Stellar Reviews, GPT Chatbot), several with live public demos. I run tailored AI trainings for technical and non-technical teams and a weekly public series on practical AI use (52 AI Tips, LinkedIn). Open source: easyprophet, a Python forecasting package on PyPI, and WeGrocery.'],
  ['Senior Data Scientist', 'Nielsen', 'Sep 2017 – Feb 2021', 'Led predictive models (time series, classification, clustering) on audience and panel data across 10+ countries, and built scalable data pipelines.'],
  ['Data Scientist, Consultant', 'Bip, Business Integration Partners', 'Apr 2016 – Sep 2017', 'Pioneer of Bip xTech CoE: delivered ML & NLP models at Sky Italy to improve retention and upselling.'],
  ['Data Science Consultant', 'SAS / Value Lab', 'Jun 2015 – Apr 2016', 'SAS Masterclass in Big Data & Analytics; built ETL pipelines and BI dashboards.'],
  ['Data Mining Junior Officer, Marketing Department', 'Università Bocconi, Alumni Association', 'Jan 2015 – Jun 2015', 'Supported the Marketing Department with data mining and analysis (SAP-CRM, STATA), generating insights and reporting on customer satisfaction to support strategic decision-making.'],
];
---
<section id="experience" class="py-12 scroll-mt-20 border-t border-line">
  <h2 class="font-serif text-3xl mb-6">Experience</h2>
  <div class="space-y-6">
    {roles.map(([title, org, dates, desc]) => (
      <div>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4">
          <h3 class="font-medium">{title} <span class="text-muted font-normal">· {org}</span></h3>
          <span class="text-muted text-sm font-mono shrink-0">{dates}</span>
        </div>
        <p class="text-muted text-sm mt-1 leading-relaxed max-w-2xl">{desc}</p>
      </div>
    ))}
  </div>
</section>
